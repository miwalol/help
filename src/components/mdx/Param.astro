---
interface Props {
  name: string;
  type: string;
  required?: boolean;
  description: string;
}

const { name, type, required, description } = Astro.props;

const typeBadgeClasses: Record<string, string> = {
  string: 'bg-blue-500/20 text-blue-400',
  number: 'bg-orange-500/20 text-orange-400',
  boolean: 'bg-purple-500/20 text-purple-400',
  array: 'bg-green-500/20 text-green-400',
  object: 'bg-yellow-500/20 text-yellow-400',
  null: 'bg-gray-500/20 text-gray-400',
};
---

<div class="flex flex-col gap-1 border-t border-border px-4 py-3">
  <div class="flex flex-wrap items-center gap-2">
    <code class="text-sm">{name}</code>
    {required && (
      <span class="rounded bg-red-500/20 px-1.5 py-0.5 text-xs font-medium text-red-400">
        required
      </span>
    )}
    {type.split('|').map((t) => {
      const trimmed = t.trim();
      return (
        <span class:list={['rounded px-1.5 py-0.5 font-mono text-xs font-medium', typeBadgeClasses[trimmed] ?? 'bg-gray-500/20 text-gray-400']}>
          {trimmed}
        </span>
      );
    })}
  </div>
  <p class="text-sm text-gray-400">{description}</p>
</div>
