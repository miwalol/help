---
const slotHtml = await Astro.slots.render('default');
const entities: Record<string, string> = { '&amp;': '&', '&quot;': '"', '&#39;': '\'', '&lt;': '<', '&gt;': '>' };
// Captured from rendered attributes, so labels are decoded here before Astro escapes them again as text.
const labels = [...slotHtml.matchAll(/<div role="tabpanel" data-label="([^"]*)"/g)]
  .map(m => m[1].replace(/&(?:amp|quot|#39|lt|gt);/g, e => entities[e]));
// Counted per page so ids stay unique when a page has several groups, and stable across builds.
Astro.locals.tabGroups = (Astro.locals.tabGroups ?? 0) + 1;
const prefix = `tabs-${Astro.locals.tabGroups}`;

let index = -1;
const panelsHtml = slotHtml.replace(/<div role="tabpanel" data-label="[^"]*"/g, () => {
  index++;
  const attrs = `id="${prefix}-panel-${index}" aria-labelledby="${prefix}-tab-${index}"`;
  return `<div role="tabpanel" ${attrs}${index === 0 ? '' : ' hidden'}`;
});
---

<div class="my-3 overflow-hidden rounded-xl border border-border">
  <div role="tablist" class="flex border-b border-border">
    {labels.map((label, i) => (
      <button
        type="button"
        role="tab"
        id={`${prefix}-tab-${i}`}
        aria-controls={`${prefix}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class:list={[
          'px-4 py-2 text-sm font-medium transition-colors text-gray-400 hover:bg-gray-700/50 hover:text-white',
          'aria-selected:bg-gray-700 aria-selected:text-white aria-selected:hover:bg-gray-700',
          'outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-500',
        ]}
      >{label}</button>
    ))}
  </div>

  <div class="[&_pre]:m-0 [&_pre]:rounded-none [&_pre]:border-none" set:html={panelsHtml} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((tablist) => {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const select = (i: number) => {
      tabs.forEach((tab, j) => {
        const selected = j === i;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !selected;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
  });
</script>
