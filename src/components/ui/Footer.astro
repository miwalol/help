---
import { Image } from 'astro:assets';
import miwaWhite from '@/assets/app/miwa-white-48.png';
---

<footer class="flex justify-between gap-4 bg-black px-2 py-4 max-md:flex-col-reverse sm:px-16 md:px-24 lg:px-32 xl:py-6 2xl:px-96">
  <div>
    <div class="mb-4 flex items-center gap-2">
      <Image src={miwaWhite} alt="Miwa.lol Logo" width={32} height={32} />

      <span class="text-2xl font-bold">
        Miwa<span class="text-indigo-700">.</span>lol
      </span>
    </div>

    <p class="mb-12">Create your own space that reflects who you are.</p>

    <span class="text-sm text-white">Copyright &copy; {new Date().getFullYear()} Miwa.lol. All rights reserved.</span>
  </div>

  <div class="flex flex-wrap gap-3.5 xl:gap-12">
    <div class="flex flex-col gap-2 text-gray-400">
      <span class="font-semibold text-white">Navigation</span>
      <a href="/" class="transition duration-100 hover:text-white">Main Help</a>
      <a href="/developers/" class="transition duration-100 hover:text-white">Developers</a>
    </div>

    <div class="flex flex-col gap-2 text-gray-400">
      <span class="font-semibold text-white">Legal</span>
      <a href="https://miwa.lol/terms" target="_blank" class="transition duration-100 hover:text-white">Terms of Service</a>
      <a href="https://miwa.lol/privacy" target="_blank" class="transition duration-100 hover:text-white">Privacy Policy</a>
    </div>
  </div>
</footer>
