---
import '@fontsource-variable/outfit';
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import SkipToContent from '@/components/SkipToContent.astro';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  markdownAlternate?: string;
}

const { title, description, canonical, type = 'website', markdownAlternate } = Astro.props;
const pageTitle = title ? `${title} | Miwa.lol Help` : 'Miwa.lol Help';
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" dir="ltr" class="font-sans antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0d26" />
    <meta name="color-scheme" content="dark" />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" href={new URL(markdownAlternate, Astro.site).toString()} />
    )}

    <meta property="og:site_name" content="Miwa.lol Help" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.toString()} />}
    <meta property="og:image" content={new URL('/opengraph-image.png', Astro.site).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MiwaTeam" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script defer data-domain="help.miwa.lol" src="https://s.tenshii.moe/_s/outbound-links.js" is:inline></script>
  </head>

  <body>
    <SkipToContent />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
